# Firebase web client config: public identifiers that ship in every browser
# bundle by design. Copy to .env for local development; in Netlify set the same
# names under Site settings > Environment variables.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
FIREBASE_PROJECT_ID=your-project-id
FIRESTORE_DATABASE_ID=your-firestore-database-id

# Optional: derived from the values above when omitted.
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=000000000000
# FIREBASE_OAUTH_CLIENT_ID=

# Server-only secrets. Never commit real values and never reference these in
# client code: they are read by the Express backend at runtime.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# (the code also accepts the name FIREBASE_SERVICE_ACCOUNT_KEY, which is
#  what the Netlify settings currently use)
# TOS_BOOTSTRAP_EMAILS= (or SUPER_ADMIN_EMAILS): temporary comma-separated
#  bootstrap emails for the first platform sign-in; clear it once the tos
#  claim is granted with scripts/grant-tos.ts.
# EXCELLENT_API_KEY=
# APP_URL=http://localhost:5173
