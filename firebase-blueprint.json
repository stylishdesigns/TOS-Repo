{
  "entities": {
    "Centre": {
      "title": "Centre",
      "description": "Tenant organization (a tutorial centre)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["trial", "active", "overdue", "suspended", "closed"] },
        "ownerUid": { "type": "string" },
        "audienceTypes": { "type": "array" },
        "autoApproveStudents": { "type": "boolean" },
        "createdAt": { "type": "string" }
      }
    },
    "CentreBilling": {
      "title": "Centre Billing Record",
      "description": "Internal subscription, plan, and seat cap limits",
      "type": "object",
      "properties": {
        "centreId": { "type": "string" },
        "planId": { "type": "string" },
        "seatCap": { "type": "number" },
        "billedSeatsMinimum": { "type": "number" },
        "skippedTrial": { "type": "boolean" },
        "discountPct": { "type": "number" }
      }
    },
    "AccessCode": {
      "title": "Access Code",
      "description": "Unique 6-digit routing code mapping to a centreId",
      "type": "object",
      "properties": {
        "centreId": { "type": "string" }
      }
    },
    "Membership": {
      "title": "Centre Membership",
      "description": "Association linking a Firebase user to a centre with an assigned role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "centreId": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "secretary", "finance", "tutor", "student"] },
        "status": { "type": "string", "enum": ["pending", "active", "disabled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "PlatformPlan": {
      "title": "Platform Plan",
      "description": "Tutorial OS pricing tiers and feature entitlements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "accountType": { "type": "string", "enum": ["centre"] },
        "price": { "type": "number" },
        "seatCap": { "type": "number" },
        "trialSeatCap": { "type": "number" },
        "trialDays": { "type": "number" }
      }
    },
    "PlatformConfig": {
      "title": "Platform Global Configuration",
      "description": "Global trial rules and discount configurations",
      "type": "object",
      "properties": {
        "trialDays": { "type": "number" },
        "skipTrialDiscountPct": { "type": "number" },
        "trialGraceDays": { "type": "number" }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Immutable server-written audit trail of platform events",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "action": { "type": "string" },
        "at": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/centres/{centreId}": { "schema": "Centre", "description": "Tutorial centres" },
    "/centreBilling/{centreId}": { "schema": "CentreBilling", "description": "Tenant subscription and billing metadata" },
    "/accessCodes/{code}": { "schema": "AccessCode", "description": "Routing access code index" },
    "/memberships/{membershipId}": { "schema": "Membership", "description": "User memberships across centres" },
    "/platformPlans/{planId}": { "schema": "PlatformPlan", "description": "Tutorial OS plan catalog" },
    "/platformConfig/global": { "schema": "PlatformConfig", "description": "Global platform settings" },
    "/auditLogs/{logId}": { "schema": "AuditLog", "description": "Platform audit log entries" }
  }
}
