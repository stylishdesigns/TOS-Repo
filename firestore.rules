rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); } // Relaxed verification for testing/bootstrap
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Admin check: signed-in user whose UID exists in the 'admins' collection.
    // Admin access comes only from admins records; no hardcoded emails.
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTutor() { 
      return isSignedIn() && exists(/databases/$(database)/documents/tutors/$(request.auth.uid));
    }

    // Platform staff (Tutorial OS) carry the `tos` claim, granted only by
    // scripts/grant-tos.ts. Writes stay server-only; staff get read access to
    // the platform's own configuration and plan documents.
    function isTos() {
      return isSignedIn() && request.auth.token.get('tos', false) == true;
    }

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // SETTINGS
    // -------------------------------------------------------------------------
    function isValidSettings(data, id) {
      return (id == 'global' && data.centreName is string && data.centreName.size() <= 200
             && data.email is string && data.email.size() <= 200)
          || (id == 'attendance' && data.resumptionTime is string && data.closingTime is string);
    }

    match /settings/{settingId} {
      allow read: if true; // Publicly accessible for website
      allow write: if isAdmin() && isValidSettings(incoming(), settingId);
    }

    // -------------------------------------------------------------------------
    // CENTRE SETTINGS (per centre: {centreId}__global | {centreId}__attendance | {centreId}__cms)
    // The part of the document id before '__' is the centre id. Members are read
    // from the m claim (centreId -> role), set by the app's session sync.
    // NOTE: assumes centre ids never contain '__' (they are centre-<slug>).
    // -------------------------------------------------------------------------
    match /centreSettings/{settingId} {
      function memberCentreRole(id) {
        return request.auth.token.get('m', {}).get(id.split('__')[0], '');
      }
      function isCentreSettingId(id) {
        return id is string && id.matches('^[a-zA-Z0-9_\\-]+__(global|attendance|cms)$');
      }
      allow read: if isSignedIn()
          && isCentreSettingId(settingId)
          && memberCentreRole(settingId) != '';
      allow write: if isSignedIn()
          && isCentreSettingId(settingId)
          && memberCentreRole(settingId) in ['own', 'adm'];
    }

    // -------------------------------------------------------------------------
    // ADMINS
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      // Only existing admins may read the staff list or write staff records.
      // A signed-in user can still read their own record (by uid or by an
      // email-filtered lookup), which the login flow needs.
      allow read: if isAdmin()
          || (isSignedIn() && request.auth.uid == adminId)
          || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // STUDENTS
    // -------------------------------------------------------------------------
    function isValidStudent(data) {
      return data.name is string && data.name.size() <= 100
          && data.regNumber is string && data.regNumber.size() <= 50
          && data.status in ['Active', 'Idle', 'Suspended', 'Completed']
          && data.totalFee is number && data.totalFee >= 0
          && data.paidAmount is number && data.paidAmount >= 0
          // A referenced programme must actually exist, so a fake id cannot be
          // attached to a student record.
          && (!('programmeId' in data)
              || (data.programmeId is string && isValidId(data.programmeId)
                  && exists(/databases/$(database)/documents/programmes/$(data.programmeId))));
    }

    // Validation for students self-registering
    function isValidStudentSelf(data) {
      return data.name is string && data.name.size() <= 100
          && data.uid == request.auth.uid
          && data.status == 'Active'
          && data.regNumber is string
          && data.email == request.auth.token.email
          // Onboarding fields don't include totalFee/paidAmount
          && !('totalFee' in data)
          && !('paidAmount' in data);
    }

    match /students/{studentId} {
      // A student's own edits may never change their uid, registration number,
      // status, fee configuration or payment status. paidAmount and
      // outstandingBalance are locked too: fees move only through the server
      // payment route (/api/centre/students/payment), which computes and
      // writes them with the admin SDK after a transaction.
      function studentSelfFieldsUnchanged() {
        return incoming().get('uid', existing().get('uid', '')) == existing().get('uid', '')
            && incoming().get('regNumber', existing().get('regNumber', '')) == existing().get('regNumber', '')
            && incoming().get('status', existing().get('status', '')) == existing().get('status', '')
            && incoming().get('totalFee', existing().get('totalFee', 0)) == existing().get('totalFee', 0)
            && incoming().get('paymentStatus', existing().get('paymentStatus', '')) == existing().get('paymentStatus', '')
            && incoming().get('paidAmount', existing().get('paidAmount', 0)) == existing().get('paidAmount', 0)
            && incoming().get('outstandingBalance', existing().get('outstandingBalance', 0)) == existing().get('outstandingBalance', 0)
            && (incoming().get('email', existing().get('email', '')) == existing().get('email', '')
                || incoming().get('email', '') == request.auth.token.email);
      }
      allow get: if isVerified() && (request.auth.uid == studentId || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isVerified() && resource.data.uid == request.auth.uid);
      allow create: if (isAdmin() && isValidStudent(incoming()) && isValidId(studentId))
                    || (isVerified() && request.auth.uid == studentId
                        && incoming().uid == request.auth.uid
                        // A future or junk timestamp cannot be planted.
                        && (!('createdAt' in incoming())
                            || (incoming().createdAt is number && incoming().createdAt <= request.time.toMillis())));
      allow update: if isAdmin() || (isVerified() && resource.data.uid == request.auth.uid && studentSelfFieldsUnchanged());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // ADMISSIONS
    // -------------------------------------------------------------------------
    function isValidAdmission(data) {
      return data.applicantName is string && data.applicantName.size() <= 100
          && data.status in ['Pending', 'Approved', 'Rejected'];
    }

    match /admissions/{admissionId} {
      allow read: if isAdmin() || (isVerified() && resource.data.email == request.auth.token.email);
      // Visitors may submit an application, but only as Pending; only admins
      // can create pre-decided records.
      allow create: if (isValidAdmission(incoming()) && incoming().status == 'Pending')
                    || (isAdmin() && isValidAdmission(incoming()));
      allow update: if isAdmin() && isValidAdmission(incoming());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // TUTORS
    // -------------------------------------------------------------------------
    match /tutors/{tutorId} {
      // A tutor may update their own profile, but the only self-service status
      // change is the first-login acceptance (status -> Active together with
      // hasChangedPassword). After that, status is staff-managed only.
      function tutorSelfWriteAllowed() {
        return incoming().get('uid', existing().get('uid', '')) == existing().get('uid', '')
            && incoming().get('email', existing().get('email', '')) == existing().get('email', '')
            && incoming().get('centreId', existing().get('centreId', '')) == existing().get('centreId', '')
            && (incoming().get('status', existing().get('status', '')) == existing().get('status', '')
                || (incoming().get('hasChangedPassword', existing().get('hasChangedPassword', false)) == true
                    && incoming().get('status', '') == 'Active'
                    && existing().get('hasChangedPassword', false) != true));
      }
      allow read: if isVerified();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == tutorId && tutorSelfWriteAllowed());
    }

    // -------------------------------------------------------------------------
    // PROGRAMMES
    // -------------------------------------------------------------------------
    match /programmes/{programmeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // PAYMENTS
    // -------------------------------------------------------------------------
    function isValidPayment(data) {
      return data.studentId is string
          && data.studentName is string && data.studentName.size() <= 150
          && data.amountPaid is number && data.amountPaid >= 0
          && data.status in ['Paid', 'Partial', 'Pending'];
    }

    match /payments/{paymentId} {
      // A payment record touches the caller's own student record when the
      // payment's studentId is the caller's uid, or it points at a student
      // record whose uid matches the caller.
      function paymentTouchesOwnRecord(data) {
        return isValidId(data.studentId)
            && (data.studentId == request.auth.uid
                || (exists(/databases/$(database)/documents/students/$(data.studentId))
                    && get(/databases/$(database)/documents/students/$(data.studentId)).data.get('uid', '') == request.auth.uid));
      }
      // Read: admins only, plus the student the payment belongs to. A centre's
      // students can never list another centre's, or another student's, fees.
      allow read: if isVerified() && (isAdmin() || paymentTouchesOwnRecord(resource.data));
      // No client may write a payment record, admins included. Student claims
      // ('Pending') and admin-recorded payments are both created by the server
      // payment routes, and confirmations/rejections by the confirm route, all
      // with the admin SDK inside a transaction that also updates the student's
      // balance. A client write could never keep the two in step.
      allow create, update, delete: if false;
    }
    
    // -------------------------------------------------------------------------
    // BRANCHES
    // -------------------------------------------------------------------------
    function isValidBranch(data) {
      return data.name is string && data.name.size() <= 200
          && data.state is string && data.state.size() <= 100;
    }

    match /branches/{branchId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidBranch(incoming());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // ATTENDANCE LOGS
    // -------------------------------------------------------------------------
    function isValidAttendanceLog(data) {
      return data.studentId is string && isValidId(data.studentId)
          && data.date is string && data.date.size() <= 20
          && data.status in ['Present', 'Late', 'Absent', 'No clock out'];
    }

    match /attendance_logs/{logId} {
      allow get: if isVerified() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isVerified() && resource.data.studentId == request.auth.uid);
      allow create, update: if isVerified() && (incoming().studentId == request.auth.uid || isAdmin()) && isValidAttendanceLog(incoming());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // ANNOUNCEMENTS
    // -------------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // SUBJECTS
    // -------------------------------------------------------------------------
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // CLASSROOMS
    // -------------------------------------------------------------------------
    match /classrooms/{classroomId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // TIMETABLE
    // -------------------------------------------------------------------------
    match /timetable/{slotId} {
      allow read: if true;
      allow write: if isAdmin() || (isVerified() && resource.data.tutorId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // RESULTS
    // -------------------------------------------------------------------------
    function isValidResult(data) {
      return data.studentId is string
          && data.studentName is string && data.studentName.size() <= 150
          && data.examTitle is string && data.examTitle.size() <= 300
          && data.totalScore is number
          && data.averagePercent is number
          && data.averagePercent >= 0 && data.averagePercent <= 100
          && data.scores is list;
    }

    match /results/{resultId} {
      allow get: if isVerified() && (resource.data.studentId == request.auth.uid || isAdmin() || isTutor());
      allow list: if isAdmin() || isTutor() || (isVerified() && resource.data.studentId == request.auth.uid);
      allow create: if (isAdmin() && isValidResult(incoming()))
                    || (isVerified() && incoming().studentId == request.auth.uid && isValidResult(incoming()));
      allow update: if (isAdmin() || isTutor()) && isValidResult(incoming());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // CBT QUESTIONS
    // -------------------------------------------------------------------------
    match /cbt_questions/{questionId} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // ACTIVITIES
    // -------------------------------------------------------------------------
    match /activities/{activityId} {
      allow read: if isAdmin();
      allow create: if isVerified();
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // CMS
    // -------------------------------------------------------------------------
    match /cms/{cmsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // CBT EXAMS
    // -------------------------------------------------------------------------
    function isValidExam(data) {
      return data.title is string && data.title.size() <= 500
          && (!('status' in data) || data.status in ['Live', 'Scheduled', 'Draft'])
          && (!('frequency' in data) || data.frequency in ['Daily', 'Weekly', 'Mock', 'General', 'Daily (CBT)', 'Weekly (CBT)'])
          && (!('mode' in data) || data.mode in ['MCQ', 'Essay', 'Both']);
    }

    match /cbt_exams/{examId} {
      allow read: if isVerified();
      allow create: if (isAdmin() || isTutor()) && isValidExam(incoming());
      allow update: if isVerified();
      allow delete: if isAdmin() || (isTutor() && resource.data.tutorId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // MOCK GRADING
    // -------------------------------------------------------------------------
    match /mock_grading/{settingId} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }
    // -------------------------------------------------------------------------
    // CLASS RATINGS
    // -------------------------------------------------------------------------
    function isValidClassRating(data) {
      return data.slotId is string
          && data.studentId is string
          && data.stars is number && data.stars >= 1 && data.stars <= 5;
    }

    match /classRatings/{ratingId} {
      allow read: if isVerified() || isAdmin() || isTutor();
      allow create, update: if isVerified() && isValidClassRating(incoming());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // TOS MOCKS (Prompt M). Mocks are owned entirely by Tutorial OS: centres,
    // admins and tutors cannot create, edit, see inside or use them. Every
    // mock collection below is read and written ONLY by the server through
    // the Admin SDK (which bypasses these rules). Browsers get nothing. The
    // default-deny catch-all at the top already blocks them; these explicit
    // blocks keep that guarantee pinned for each collection by name.
    // -------------------------------------------------------------------------
    // -------------------------------------------------------------------------
    // PLATFORM-LEVEL COLLECTIONS (Tutorial OS staff, by the `tos` claim)
    // -------------------------------------------------------------------------
    match /platformConfig/{doc}  { allow read: if isTos(); }
    match /platformPlans/{doc}   { allow read: if isTos(); }

    match /mocks/{doc}          { allow read, write: if false; }
    match /mockPapers/{doc}     { allow read, write: if false; }
    match /mockKeys/{doc}       { allow read, write: if false; }
    match /mockAttempts/{doc}   { allow read, write: if false; }
    match /mockScoreTally/{doc} { allow read, write: if false; }
    match /mockLeaderboards/{doc} { allow read, write: if false; }
    match /usernames/{doc}      { allow read, write: if false; }
    match /mockSettings/{doc}   { allow read, write: if false; }
  }
}
